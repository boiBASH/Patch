{
  "name": "release-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local API exposure investigation and verified remediation prototype",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --use-system-ca src/server.mjs",
    "dev": "node --use-system-ca --watch src/server.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "build": "node scripts/verify.mjs",
    "demo": "node src/cli.mjs --mode=demo",
    "investigate": "node --use-system-ca src/cli.mjs --mode=openrouter",
    "investigate:project": "node --use-system-ca scripts/investigate-project.mjs",
    "security": "node scripts/security.mjs"
  }
}
